# =====================================================================
#  Huellitas de Amor — variables de entorno
#  Copia este archivo como .env y ajusta los valores.
#  NUNCA subas el .env real a Git.
#
#  Estas mismas variables hay que cargarlas en Vercel:
#  Project Settings → Environment Variables.
# =====================================================================

NODE_ENV=development
PORT=3000

# Zona horaria de la clínica. Se llama CLINICA_TZ y no TZ porque Vercel
# reserva ese nombre y además la define en UTC por su cuenta. La agenda trabaja en hora local, y los
# servidores de Vercel arrancan en UTC, así que esta variable es obligatoria
# en producción para que "hoy" y los horarios cuadren.
CLINICA_TZ=America/Bogota

# --- Base de datos: Supabase (PostgreSQL) ----------------------------
# Panel de Supabase → Project Settings → Database → Connection string → URI.
#
# Usa el POOLER en modo transacción (puerto 6543) para la aplicación: es el
# que aguanta bien las funciones serverless de Vercel.
#   postgresql://postgres.abcdefgh:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Para `npm run db:setup` sirve la misma cadena; si diera problemas, usa la
# conexión directa (puerto 5432) que aparece en el mismo panel.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Conexiones simultáneas del pool. En serverless conviene poco: cada instancia
# abre su propio pool y el plan gratuito de Supabase admite pocas.
DB_POOL=3

# A partir de cuántos milisegundos se anota una consulta como lenta en el
# registro. En Vercel una consulta lenta se come el tiempo de la función y
# termina en un 504 que por fuera parece "la web no carga", así que conviene
# verlas venir. Se consultan desde el panel: Seguridad → GET /api/seguridad/consultas.
DB_CONSULTA_LENTA_MS=1000

# TLS contra Supabase. Déjalo en require salvo que uses un PostgreSQL local.
DB_SSL=require

# --- Supabase Storage (fotos de las mascotas) ------------------------
# Panel de Supabase → Project Settings → API.
# En Vercel el disco es de solo lectura, así que las imágenes van aquí.
# Si dejas estas variables vacías, en local las fotos se guardan en uploads/.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role: es una clave de administrador. Solo en el servidor, jamás
# en el frontend ni en un repositorio público.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=mascotas

# --- Despliegue ------------------------------------------------------
# El VERCEL_TOKEN ya NO va aquí: vive en su propio archivo, .env.deploy,
# en la raíz del proyecto y con una sola línea:
#
#   VERCEL_TOKEN=...
#
# La razón es que este .env lo carga también la aplicación, así que todo
# lo que esté aquí acaba en el process.env del proceso que atiende las
# peticiones. Ese token no lo usa ninguna ruta y da control total de la
# cuenta de Vercel, así que no tiene por qué estar ahí.
# Se crea en: vercel.com/account/tokens

# --- Sesiones ---------------------------------------------------------
# En producción es obligatorio y debe tener 32+ caracteres aleatorios.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES=8h

# La sesión de administración vive menos que las demás: es la que puede tocar
# usuarios, roles, facturación y configuración de seguridad.
JWT_EXPIRES_ADMIN=2h

# Minutos que puede estar una sesión sin usarse antes de cerrarse sola. Es
# distinto del vencimiento del token: evita dejar la sesión abierta en el
# computador del mostrador después de irse a almorzar.
SESION_INACTIVIDAD_MIN=60

# --- Cifrado de datos en la base --------------------------------------
# Llave con la que se cifra lo delicado que el servidor necesita poder volver
# a leer: hoy, el secreto de la verificación en dos pasos. Sin ella ese secreto
# quedaría en claro en la base, y una copia de la tabla entregaría el segundo
# factor de las cuentas de administración.
#
# OJO: esta llave NO se rota como JWT_SECRET. Cambiarla deja ilegible lo que ya
# está guardado, y quien tenga el segundo factor puesto tendrá que volver a
# configurarlo. Se define una vez y se deja quieta.
#
# Se genera igual que la de arriba:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Si se deja vacía, se deriva de JWT_SECRET y todo funciona igual, pero
# entonces cambiar JWT_SECRET sí rompería los secretos guardados.
CIFRADO_CLAVE=

# --- Verificación en dos pasos ---------------------------------------
# Roles que NO pueden entrar sin segundo factor, separados por coma.
# Quien tenga uno de estos roles y no lo haya configurado solo podrá
# configurarlo: el resto de la API le responde 403.
#
# Para exigirlo también al personal clínico: MFA_ROLES=admin,veterinario
# Avisa antes al equipo, porque el bloqueo empieza en su siguiente ingreso.
MFA_ROLES=admin

# --- Correo saliente (código de ingreso) ------------------------------
# Por aquí sale el código de seis cifras del segundo paso del ingreso.
# Sin estas dos líneas el envío queda apagado y los roles de MFA_ROLES
# vuelven a necesitar la aplicación de códigos.
#
# Con Gmail, CORREO_PASSWORD NO es la contraseña de la cuenta: es una
# "contraseña de aplicación" de dieciséis letras. Se crea en
# myaccount.google.com -> Seguridad -> Verificación en dos pasos ->
# Contraseñas de aplicaciones (hace falta tener la verificación en dos
# pasos activa en esa cuenta de Google). Solo sirve para mandar correo y
# se puede revocar sin tocar la contraseña de verdad.
CORREO_USUARIO=
CORREO_PASSWORD=

# Servidor SMTP. Los valores de fábrica son los de Gmail; con otro
# proveedor se cambian aquí. El 465 va cifrado desde el primer byte.
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=465

# Cómo se ve el remitente en la bandeja de quien lo recibe. Gmail obliga a
# que CORREO_REMITENTE sea la misma cuenta que autentica.
CORREO_NOMBRE=Huellitas de Amor
CORREO_REMITENTE=

# --- Dirección pública del sitio --------------------------------------
# La usa el enlace del correo de recuperación de contraseña. Sin ella el
# enlace se arma con el encabezado Host de la petición, y ese lo escribe
# quien la manda: bastaría una petición con otro Host para que a alguien
# le llegara un correo nuestro con un enlace hacia un sitio ajeno.
# En local puedes dejarla vacía; entonces se usa el origen de la petición.
APP_URL=

# --- CORS -------------------------------------------------------------
# Solo hace falta si el frontend vive en otro origen (Live Server en local,
# o un despliegue aparte). En Vercel el frontend y la API comparten dominio.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Reglas de la agenda ---------------------------------------------
CLINICA_APERTURA=08:00
CLINICA_CIERRE=20:00
# Días que abre la clínica: 0=domingo … 6=sábado
CLINICA_DIAS=1,2,3,4,5,6,0
# Anticipación mínima para reservar una cita (minutos)
CITAS_ANTICIPACION_MIN=60
# Cuántos días hacia adelante se puede agendar
CITAS_DIAS_MAX=60

# --- Archivos subidos -------------------------------------------------
UPLOAD_MAX_BYTES=3145728
